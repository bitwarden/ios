# End-to-end UI test configuration. Copy to .e2e.env (gitignored) and fill in all five values.
# Never commit real values: this repository is public.
# URLs must be https; bitwarden.com and bitwarden.eu hosts are rejected.

# Base URL of the server under test.
BW_TEST_SERVER_URL=https://vault.example.com
# Base URL of that server's seeder API.
BW_SEEDER_URL=https://vault.example.com/seeder
# Whether the server under test is self-hosted: true or false.
BW_SEEDER_SELF_HOSTED=true
# Seeder API basic-auth credentials.
BW_SEEDER_USERNAME=
BW_SEEDER_PASSWORD=
