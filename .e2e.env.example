# Configuration for the end-to-end UI tests when they are started from Xcode.
#
# Copy this file to .e2e.env and fill in the values for the server you test against:
#
#   cp .e2e.env.example .e2e.env
#
# .e2e.env is gitignored. Never commit real values: this repository is public, so the server
# under test and its credentials must not appear in it.
#
# All five values are required. A value that is missing or breaks a rule below fails each test
# with the variable's name.
#
# Scripts/run-e2e-tests.sh and CI don't read this file: they take the same five variables from
# the environment, and a variable set there wins over this file.

# The base URL of the server under test, for example the address you would enter as a
# self-hosted server URL in the app.
# Why: the app has no test server built in. Each test launches it with this URL, so it is the
# server the app logs in to and syncs with.
# Rules: https only. bitwarden.com and bitwarden.eu hosts are rejected, so the tests can never
# create data on a production server.
BW_TEST_SERVER_URL=https://vault.example.com

# The base URL of the seeder API that belongs to that server. On a self-hosted server it is
# usually the server URL followed by /seeder; a cloud environment has a separate seeder host.
# Why: every test creates its own account and vault data through the seeder before logging in,
# and deletes them afterwards. It must be the seeder of the same server as BW_TEST_SERVER_URL,
# otherwise the app can't log in with the account the test just created.
# Rules: the same as BW_TEST_SERVER_URL.
BW_SEEDER_URL=https://vault.example.com/seeder

# Whether the server under test is self-hosted: true or false.
# Why: the seeder sets up paid features differently on a self-hosted server, where they come
# from a license file instead of a subscription. The value is sent with every account the
# tests create, so it has to match the server.
BW_SEEDER_SELF_HOSTED=true

# The username and password of the seeder API (HTTP basic authentication).
# Why: the seeder can create and delete accounts, so it rejects requests without credentials.
# Ask the owner of the test server for them. They are never printed in test output.
BW_SEEDER_USERNAME=
BW_SEEDER_PASSWORD=
