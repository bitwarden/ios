<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- An error report if there are issues decrypting vault items. -->
    <key>BitwardenCouldNotDecryptXVaultItemsDescriptionLong</key>
    <dict>
      <key>NSStringLocalizedFormatKey</key>
      <string>%#@BitwardenCouldNotDecryptVaultItems@ Nukopijuokite ir bendrinkite šią klaidų ataskaitą su klientų aptarnavimo tarnyba, kad išvengtumėte papildomų duomenų praradimų.</string>
      <key>BitwardenCouldNotDecryptVaultItems</key>
      <dict>
        <key>NSStringFormatSpecTypeKey</key>
        <string>NSStringPluralRuleType</string>
        <key>NSStringFormatValueTypeKey</key>
        <string>d</string>
        <key>one</key>
        <string>„Bitwarden“ nepavyko iššifruoti %d saugyklos elemento.</string>
        <key>few</key>
        <string>„Bitwarden“ nepavyko iššifruoti %d saugyklos elementų.</string>
        <key>many</key>
        <string>„Bitwarden“ nepavyko iššifruoti %d saugyklos elementų.</string>
        <key>other</key>
        <string>„Bitwarden“ nepavyko iššifruoti %d saugyklos elementų.</string>
      </dict>
    </dict>
    <!-- A message indicating the minimum length of a master password in characters. -->
    <key>MasterPasswordMustBeAtLeastXCharactersLong</key>
    <dict>
      <key>NSStringLocalizedFormatKey</key>
      <string>%#@MasterPasswordMustBeAtLeastCharactersLong@</string>
      <key>MasterPasswordMustBeAtLeastCharactersLong</key>
      <dict>
        <key>NSStringFormatSpecTypeKey</key>
        <string>NSStringPluralRuleType</string>
        <key>NSStringFormatValueTypeKey</key>
        <string>d</string>
        <key>one</key>
        <string>Pagrindinis slaptažodis turi būti bent %d simbolio ilgio.</string>
        <key>few</key>
        <string>Pagrindinis slaptažodis turi būti bent %d simbolių ilgio.</string>
        <key>many</key>
        <string>Pagrindinis slaptažodis turi būti bent %d simbolių ilgio.</string>
        <key>other</key>
        <string>Pagrindinis slaptažodis turi būti bent %d simbolių ilgio.</string>
      </dict>
    </dict>
    <!-- A warning if we have determined that a password has been exposed in a data breach. -->
    <key>ThisPasswordHasBeenExposedXTimesDescriptionLong</key>
    <dict>
      <key>NSStringLocalizedFormatKey</key>
      <string>%#@ThisPasswordHasBeenExposedTimes@ Turėtumėte jį pakeisti.</string>
      <key>ThisPasswordHasBeenExposedTimes</key>
      <dict>
        <key>NSStringFormatSpecTypeKey</key>
        <string>NSStringPluralRuleType</string>
        <key>NSStringFormatValueTypeKey</key>
        <string>d</string>
        <key>one</key>
        <string>Šis slaptažodis buvo atskleistas %d kartą duomenų nutekėjimų metu.</string>
        <key>few</key>
        <string>Šis slaptažodis buvo atskleistas %d kartus duomenų nutekėjimų metu.</string>
        <key>many</key>
        <string>Šis slaptažodis buvo atskleistas %d kartus duomenų nutekėjimų metu.</string>
        <key>other</key>
        <string>Šis slaptažodis buvo atskleistas %d kartus duomenų nutekėjimų metu.</string>
      </dict>
    </dict>
    <!-- A number of characters, as in letters/numbers/punctuation. For example, the minimum number of characters when creating a password. -->
    <key>XCharacters</key>
    <dict>
      <key>NSStringLocalizedFormatKey</key>
      <string>%#@Characters@</string>
      <key>Characters</key>
      <dict>
        <key>NSStringFormatSpecTypeKey</key>
        <string>NSStringPluralRuleType</string>
        <key>NSStringFormatValueTypeKey</key>
        <string>d</string>
        <key>one</key>
        <string>%d simbolis</string>
        <key>few</key>
        <string>%d simboliai</string>
        <key>many</key>
        <string>%d simbolių</string>
        <key>other</key>
        <string>%d simbolių</string>
      </dict>
    </dict>
    <!-- A number of days, used in menu selections. For example, the number of days to keep a send before deletion. -->
    <key>XDays</key>
    <dict>
      <key>NSStringLocalizedFormatKey</key>
      <string>%#@Days@</string>
      <key>Days</key>
      <dict>
        <key>NSStringFormatSpecTypeKey</key>
        <string>NSStringPluralRuleType</string>
        <key>NSStringFormatValueTypeKey</key>
        <string>d</string>
        <key>one</key>
        <string>%d diena</string>
        <key>few</key>
        <string>%d dienos</string>
        <key>many</key>
        <string>%d dienų</string>
        <key>other</key>
        <string>%d dienų</string>
      </dict>
    </dict>
    <!-- A number of hours, used in menu selections. For example, how long to log events in the flight recorder. -->
    <key>XHours</key>
    <dict>
      <key>NSStringLocalizedFormatKey</key>
      <string>%#@Hours@</string>
      <key>Hours</key>
      <dict>
        <key>NSStringFormatSpecTypeKey</key>
        <string>NSStringPluralRuleType</string>
        <key>NSStringFormatValueTypeKey</key>
        <string>d</string>
        <key>one</key>
        <string>%d valanda</string>
        <key>few</key>
        <string>%d valandos</string>
        <key>many</key>
        <string>%d valandų</string>
        <key>other</key>
        <string>%d valandų</string>
      </dict>
    </dict>
    <!-- A number of items, used in headers' voiceover to indicate how many items are in a section. -->
    <key>XItems</key>
    <dict>
      <key>NSStringLocalizedFormatKey</key>
      <string>%#@Items@</string>
      <key>Items</key>
      <dict>
        <key>NSStringFormatSpecTypeKey</key>
        <string>NSStringPluralRuleType</string>
        <key>NSStringFormatValueTypeKey</key>
        <string>d</string>
        <key>one</key>
        <string>%d elementas</string>
        <key>few</key>
        <string>%d elementai</string>
        <key>many</key>
        <string>%d elementų</string>
        <key>other</key>
        <string>%d elementų</string>
      </dict>
    </dict>
    <!-- Message indicating a number of items were successfully imported in the Credential Exchange flow. -->
    <key>XItemsSuccessfullyImported</key>
    <dict>
      <key>NSStringLocalizedFormatKey</key>
      <string>%#@ItemsSuccessfullyImported@</string>
      <key>ItemsSuccessfullyImported</key>
      <dict>
        <key>NSStringFormatSpecTypeKey</key>
        <string>NSStringPluralRuleType</string>
        <key>NSStringFormatValueTypeKey</key>
        <string>d</string>
        <key>one</key>
        <string>%d elementas sėkmingai importuotas</string>
        <key>few</key>
        <string>%d elementai sėkmingai importuoti</string>
        <key>many</key>
        <string>%d elementų sėkmingai importuota</string>
        <key>other</key>
        <string>%d elementų sėkmingai importuota</string>
      </dict>
    </dict>
    <!-- A number of minutes, used in menu selections. For example, the amount of time to keep the vault unlocked after being unlocked. -->
    <key>XMinutes</key>
    <dict>
      <key>NSStringLocalizedFormatKey</key>
      <string>%#@Minutes@</string>
      <key>Minutes</key>
      <dict>
        <key>NSStringFormatSpecTypeKey</key>
        <string>NSStringPluralRuleType</string>
        <key>NSStringFormatValueTypeKey</key>
        <string>d</string>
        <key>one</key>
        <string>%d minutė</string>
        <key>few</key>
        <string>%d minutės</string>
        <key>many</key>
        <string>%d minučių</string>
        <key>other</key>
        <string>%d minučių</string>
      </dict>
    </dict>
    <!-- A number of seconds, used in menu selection. For example, how long to keep copied fields in the clipboard before clearing. -->
    <key>XSeconds</key>
    <dict>
      <key>NSStringLocalizedFormatKey</key>
      <string>%#@Seconds@</string>
      <key>Seconds</key>
      <dict>
        <key>NSStringFormatSpecTypeKey</key>
        <string>NSStringPluralRuleType</string>
        <key>NSStringFormatValueTypeKey</key>
        <string>d</string>
        <key>one</key>
        <string>%d sekundė</string>
        <key>few</key>
        <string>%d sekundės</string>
        <key>many</key>
        <string>%d sekundžių</string>
        <key>other</key>
        <string>%d sekundžių</string>
      </dict>
    </dict>
    <!-- A number of weeks, used in menu selection. For example, how long to log events in the flight recorder. -->
    <key>XWeeks</key>
    <dict>
      <key>NSStringLocalizedFormatKey</key>
      <string>%#@Weeks@</string>
      <key>Weeks</key>
      <dict>
        <key>NSStringFormatSpecTypeKey</key>
        <string>NSStringPluralRuleType</string>
        <key>NSStringFormatValueTypeKey</key>
        <string>d</string>
        <key>one</key>
        <string>%d savaitė</string>
        <key>few</key>
        <string>%d savaitės</string>
        <key>many</key>
        <string>%d savaičių</string>
        <key>other</key>
        <string>%d savaičių</string>
      </dict>
    </dict>
    <!-- A message indicating the grace period for a past due subscription, with pluralized days and the date. -->
    <key>YouHaveAGracePeriodOfXDaysFromYourSubscriptionDescriptionLong</key>
    <dict>
      <key>NSStringLocalizedFormatKey</key>
      <string>%1$#@YouHaveAGracePeriodOfXDaysFromYourSubscriptionExpirationDate@ Prašome apmokėti pradelstas sąskaitas iki **%2$@**.</string>
      <key>YouHaveAGracePeriodOfXDaysFromYourSubscriptionExpirationDate</key>
      <dict>
        <key>NSStringFormatSpecTypeKey</key>
        <string>NSStringPluralRuleType</string>
        <key>NSStringFormatValueTypeKey</key>
        <string>d</string>
        <key>one</key>
        <string>Jūs turite %1$d dienos lengvatinį laikotarpį nuo prenumeratos pabaigos datos.</string>
        <key>few</key>
        <string>Jūs turite %1$d dienų lengvatinį laikotarpį nuo prenumeratos pabaigos datos.</string>
        <key>many</key>
        <string>Jūs turite %1$d dienų lengvatinį laikotarpį nuo prenumeratos pabaigos datos.</string>
        <key>other</key>
        <string>Jūs turite %1$d dienų lengvatinį laikotarpį nuo prenumeratos pabaigos datos.</string>
      </dict>
    </dict>
    <!-- A message indicating the minimum length of a PIN in characters. -->
    <key>YourPINMustBeAtLeastXCharactersDescriptionLong</key>
    <dict>
      <key>NSStringLocalizedFormatKey</key>
      <string>%#@YourPINMustBeAtLeastCharacters@ Jūsų PIN nustatymai bus iš naujo nustatyti, jei kada nors visiškai atsijungsite nuo programos.</string>
      <key>YourPINMustBeAtLeastCharacters</key>
      <dict>
        <key>NSStringFormatSpecTypeKey</key>
        <string>NSStringPluralRuleType</string>
        <key>NSStringFormatValueTypeKey</key>
        <string>d</string>
        <key>one</key>
        <string>Jūsų PIN kodas turi būti bent %d simbolio ilgio.</string>
        <key>few</key>
        <string>Jūsų PIN kodas turi būti bent %d simbolių ilgio.</string>
        <key>many</key>
        <string>Jūsų PIN kodas turi būti bent %d simbolių ilgio.</string>
        <key>other</key>
        <string>Jūsų PIN kodas turi būti bent %d simbolių ilgio.</string>
      </dict>
    </dict>
  </dict>
</plist>
